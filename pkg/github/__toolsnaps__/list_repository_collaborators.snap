{
  "annotations": {
    "readOnlyHint": true,
    "title": "List repository collaborators"
  },
  "description": "List collaborators of a GitHub repository",
  "inputSchema": {
    "properties": {
      "affiliation": {
        "description": "Filter collaborators by affiliation: 'outside' (external collaborators), 'direct' (direct collaborators), or 'all' (default)",
        "enum": [
          "outside",
          "direct",
          "all"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (username or organization)",
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "permission": {
        "description": "Filter collaborators by permission: 'pull', 'triage', 'push', 'maintain', or 'admin'",
        "enum": [
          "pull",
          "triage",
          "push",
          "maintain",
          "admin"
        ],
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_repository_collaborators"
}